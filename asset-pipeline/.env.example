# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Anthropic / Claude API key (required for PDF parsing)
ANTHROPIC_API_KEY=

# Microsoft Azure credentials (required only if using SharePoint upload)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# Optional overrides
# LOCAL_OUTPUT_FOLDER=output
# SHAREPOINT_FOLDER=Marketing/Assets
# CLAUDE_MODEL=claude-sonnet-4-20250514
# HOST=127.0.0.1
# PORT=8000
